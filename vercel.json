{
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/acc-audit",
      "schedule": "0 4 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.karbanapp.ir"
        }
      ],
      "destination": "https://karbanapp.ir/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/auth/callback/:path*", "destination": "/index.html" },
    { "source": "/فاکتورساز", "destination": "/index.html" },
    { "source": "/%D9%81%D8%A7%DA%A9%D8%AA%D9%88%D8%B1%D8%B3%D8%A7%D8%B2", "destination": "/index.html" },
    { "source": "/ورود", "destination": "/index.html" },
    { "source": "/%D9%88%D8%B1%D9%88%D8%AF", "destination": "/index.html" },
    { "source": "/داشبورد", "destination": "/index.html" },
    { "source": "/داشبورد/:path*", "destination": "/index.html" },
    { "source": "/%D8%AF%D8%A7%D8%B4%D8%A8%D9%88%D8%B1%D8%AF", "destination": "/index.html" },
    { "source": "/%D8%AF%D8%A7%D8%B4%D8%A8%D9%88%D8%B1%D8%AF/:path*", "destination": "/index.html" },
    { "source": "/پروفایل", "destination": "/index.html" },
    { "source": "/%D9%BE%D8%B1%D9%88%D9%81%D8%A7%DB%8C%D9%84", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/سفارش/:path*", "destination": "/index.html" },
    { "source": "/%D8%B3%D9%81%D8%A7%D8%B1%D8%B4/:path*", "destination": "/index.html" },
    { "source": "/کارفرما", "destination": "/index.html" },
    { "source": "/%DA%A9%D8%A7%D8%B1%D9%81%D8%B1%D9%85%D8%A7", "destination": "/index.html" },
    { "source": "/کارمند", "destination": "/index.html" },
    { "source": "/%DA%A9%D8%A7%D8%B1%D9%85%D9%86%D8%AF", "destination": "/index.html" },
    { "source": "/فریلنسر", "destination": "/index.html" },
    { "source": "/%D9%81%D8%B1%DB%8C%D9%84%D9%86%D8%B3%D8%B1", "destination": "/index.html" },
    { "source": "/حسابداری", "destination": "/index.html" },
    { "source": "/%D8%AD%D8%B3%D8%A7%D8%A8%D8%AF%D8%A7%D8%B1%DB%8C", "destination": "/index.html" },
    { "source": "/حسابداری/:path*", "destination": "/index.html" },
    { "source": "/%D8%AD%D8%B3%D8%A7%D8%A8%D8%AF%D8%A7%D8%B1%DB%8C/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://rocjeanizzhfvhnuhnms.supabase.co https://trustseal.enamad.ir https://www.google-analytics.com https://*.google-analytics.com; connect-src 'self' https://rocjeanizzhfvhnuhnms.supabase.co wss://rocjeanizzhfvhnuhnms.supabase.co https://api.telegram.org https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
